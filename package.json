{
    "name": "pricelist",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "opennextjs-cloudflare build",
        "build:next": "prisma generate && node scripts/patch-prisma-client.mjs && next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "postinstall": "node scripts/patch-prisma-client.mjs",
        "db:generate": "prisma generate && node scripts/patch-prisma-client.mjs",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:reset:local": "node scripts/local-dev/reset-local-db.mjs",
        "ca:sync": "node scripts/sync-db-ca.mjs",
        "prebuild": "node scripts/sync-db-ca.mjs"
    },
    "overrides": {
        "esbuild": "^0.24.0"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^6.19.3",
        "@prisma/client": "^6.19.3",
        "bcryptjs": "2.4.3",
        "clsx": "2.1.1",
        "esbuild": "^0.24.0",
        "lucide-react": "0.469.0",
        "next": "^15.5.28",
        "next-auth": "4.24.11",
        "nodemailer": "^6.10.1",
        "pg": "^8.16.3",
        "pg-cloudflare": "^1.4.1",
        "prisma": "^6.19.3",
        "qrcode": "1.5.4",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "tailwind-merge": "2.6.0",
        "zod": "3.24.1"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20240208.0",
        "@opennextjs/cloudflare": "^1.20.12",
        "@types/bcryptjs": "2.4.6",
        "@types/node": "22.10.2",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.15.5",
        "@types/qrcode": "1.5.5",
        "@types/react": "18.3.18",
        "@types/react-dom": "18.3.5",
        "assert": "^2.1.0",
        "autoprefixer": "10.4.20",
        "browserify-zlib": "^0.2.0",
        "buffer": "^6.0.3",
        "crypto-browserify": "^3.12.1",
        "eslint": "8.57.0",
        "eslint-config-next": "14.2.30",
        "events": "^3.3.0",
        "https-browserify": "^1.0.0",
        "postcss": "8.4.49",
        "process": "^0.11.10",
        "querystring-es3": "^0.2.1",
        "stream-browserify": "^3.0.0",
        "stream-http": "^3.2.0",
        "tailwindcss": "^3.4.17",
        "tsx": "4.19.2",
        "typescript": "5.7.2",
        "url": "^0.11.4",
        "util": "^0.12.5",
        "vitest": "2.1.8",
        "vm-browserify": "^1.1.2",
        "wrangler": "^4.151.0"
    }
}
