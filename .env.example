# PRICELIST environment configuration
# Copy to .env and fill in. Never commit secrets.

# App
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# Database — PostgreSQL only. The connection string must point at the
# session pooler (port 5432), and the schema is applied with:
#   npx prisma migrate deploy
DATABASE_URL="postgresql://user:password@db.example.com:5432/postgres?sslmode=no-verify"

# Paystack (Nigerian payments) — leave empty for development mode
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# AI services (optional — app works without them)
OPENAI_API_KEY=

# Storage (optional — local uploads used when empty)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (optional — password reset shows a dev link when unset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Development billing — must stay off in production. When true, the billing
# UI lets an authenticated user self-activate a paid plan without a payment.
ALLOW_DEV_BILLING=
