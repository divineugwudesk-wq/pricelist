# PRICELIST environment configuration
# Copy to .env and fill in. Never commit secrets.

# App
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# Database — development uses SQLite; switch provider to "postgresql" in
# prisma/schema.prisma and use a Postgres connection string for production.
DATABASE_URL="file:./dev.db"

# Paystack (Nigerian payments) — leave empty for development mode
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# AI services (optional — app works without them)
OPENAI_API_KEY=

# Storage (optional — local uploads used when empty)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (optional — password reset shows a dev link when unset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
